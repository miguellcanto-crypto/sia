generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Permission {
  // Ventas
  CREATE_SALE
  VIEW_SALES
  CANCEL_SALE
  REFUND_SALE

  // Productos
  CREATE_PRODUCT
  EDIT_PRODUCT
  DELETE_PRODUCT
  VIEW_PRODUCT
  ADJUST_STOCK
  EDIT_PRICE
  MANAGE_PRODUCTS

  // Usuarios
  CREATE_USER
  EDIT_USER
  DELETE_USER
  VIEW_USERS

  // Clientes
  CREATE_CUSTOMER
  EDIT_CUSTOMER
  DELETE_CUSTOMER
  VIEW_CUSTOMERS

  // Reportes
  VIEW_REPORTS
  EXPORT_REPORTS

  // Promociones
  CREATE_PROMOTION
  EDIT_PROMOTION
  DELETE_PROMOTION

  // Categorías
  MANAGE_CATEGORIES

  // Sistema
  VIEW_AUDIT_LOG
  VIEW_ERROR_LOG
  MANAGE_SETTINGS
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  BUY_X_GET_Y
  COMBO
  FREE_SHIPPING
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SALE_CREATED
  SALE_CANCELLED
  PRICE_CHANGED
  STOCK_ADJUSTED
  PROMOTION_APPLIED
  REFUND_PROCESSED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  IGNORED
}

enum MovementType {
  PURCHASE // Compra
  SALE // Venta
  ADJUSTMENT // Ajuste
  WASTE // Merma/Desperdicio
  RETURN // Devolución
  INITIAL // Inventario inicial
}

enum CashSessionStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum CashMovementType {
  CASH_IN // Entrada de efectivo
  CASH_OUT // Retiro de efectivo
  INITIAL // Monto inicial
  ADJUSTMENT // Ajuste
}

enum RefundType {
  FULL
  PARTIAL
  EXCHANGE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  PROMOTION
  MANUAL
  COUPON
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  PRE_ORDER
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // ADMIN, CASHIER, MANAGER, etc.
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  passwordHash   String
  emailVerified  DateTime?
  status         AccountStatus        @default(ACTIVE)
  failedAttempts Int                  @default(0)
  lockoutUntil   DateTime?
  roleId         String
  role           Role                 @relation(fields: [roleId], references: [id])
  lastLogin      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sales          Sale[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  priceHistory   PriceHistory[]
  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]

  // Enterprise POS Relations
  cashSessions  CashSession[]
  cashMovements CashMovement[]
  orders        Order[]
  refunds       Refund[]       @relation("ProcessedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Category {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  parentId    String? // Para subcategorías
  parent      Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]          @relation("CategoryHierarchy")
  products    Product[]
  promotions  PromotionCategory[]
  image       String?
  isActive    Boolean             @default(true)
  order       Int                 @default(0) // Para ordenar en el menú
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  cost        Decimal @db.Decimal(10, 2)
  stock       Decimal @default(0) @db.Decimal(10, 3) // Changed Int to Decimal for kg support
  minStock    Decimal @default(5) @db.Decimal(10, 3)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Específico para marisquería
  unit      String? // kg, lb, unidad, docena
  isFresh   Boolean @default(true)
  isSeafood Boolean @default(true)

  image    String?
  isActive Boolean @default(true)

  // Robustness & Inventory Rules
  version       Int?    @default(0) // For optimistic locking
  criticalStock Decimal @default(0) @db.Decimal(10, 3) // Hard alert threshold

  // Pesables & Escala
  isWeighable  Boolean  @default(false)
  pricePerUnit Decimal? @db.Decimal(10, 2)
  tareWeight   Decimal? @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]
  priceHistory   PriceHistory[]
  promotions     PromotionProduct[]
  refundItems    RefundItem[]
  orderItems     OrderItem[]

  @@index([code])
  @@index([categoryId])
  @@index([stock])
}

model Customer {
  id      String  @id @default(cuid())
  code    String  @unique // Código de cliente
  name    String
  email   String? @unique
  phone   String?
  address String?

  // Fidelización
  points Int     @default(0)
  tier   String? // Bronze, Silver, Gold, etc.

  // Información fiscal (si aplica)
  taxId   String? @unique // RFC, RUC, etc.
  company String?

  isActive Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales  Sale[]
  orders Order[]

  @@index([code])
}

model Sale {
  id         String  @id @default(cuid())
  saleNumber String  @unique // Número de venta correlativo
  subtotal   Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  tax        Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @db.Decimal(10, 2)

  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)

  // Pago
  amountPaid Decimal? @db.Decimal(10, 2)
  change     Decimal? @db.Decimal(10, 2)

  // Propinas
  tip        Decimal? @default(0) @db.Decimal(10, 2)
  tipPercent Decimal? @db.Decimal(5, 2)

  // Referencias
  notes         String? @db.Text
  invoiceNumber String? @unique

  date DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items      SaleItem[]
  promotions SalePromotion[]

  // Devoluciones e Historial
  refundedSaleId String?  @unique
  refundedSale   Sale?    @relation("SaleRefund", fields: [refundedSaleId], references: [id])
  refund         Sale?    @relation("SaleRefund")
  refundRecords  Refund[]

  // Descuentos y Autorización
  discounts    SaleDiscount[]
  authorizedBy String?
  authReason   String?

  // Caja y Órdenes
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  order         Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleNumber])
  @@index([date])
  @@index([userId])
}

model SaleItem {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(10, 3)
  price    Decimal @db.Decimal(10, 2)
  subtotal Decimal @db.Decimal(10, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Promotion {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  status      PromotionStatus @default(INACTIVE)

  // Descuento
  discountValue Decimal? @db.Decimal(10, 2)

  // Fechas
  startDate DateTime
  endDate   DateTime

  // Condiciones
  minPurchase Decimal? @db.Decimal(10, 2)
  maxUses     Int?
  usesCount   Int      @default(0)

  // Días de la semana (JSON array: [0,1,2,3,4,5,6])
  activeDays String?

  // Relaciones
  products   PromotionProduct[]
  categories PromotionCategory[]
  sales      SalePromotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
}

model PromotionCategory {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
}

model SalePromotion {
  id          String    @id @default(cuid())
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  discount    Decimal   @db.Decimal(10, 2)
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String // Product, Sale, User, etc.
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model ErrorLog {
  id       String        @id @default(cuid())
  message  String
  stack    String?       @db.Text
  severity ErrorSeverity @default(MEDIUM)
  status   ErrorStatus   @default(NEW)

  // Contexto
  endpoint  String?
  method    String?
  userId    String?
  ipAddress String?
  userAgent String?

  // Datos adicionales
  metadata Json?

  // Resolución
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity, status])
  @@index([createdAt])
}

model StockMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  previousStock Decimal      @db.Decimal(10, 3)
  newStock      Decimal      @db.Decimal(10, 3)

  reason    String?
  reference String? // Número de compra, venta, etc.

  userId String?
  user   User?    @relation(fields: [userId], references: [id])
  cost   Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model PriceHistory {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  oldPrice Decimal  @db.Decimal(10, 2)
  newPrice Decimal  @db.Decimal(10, 2)
  oldCost  Decimal? @db.Decimal(10, 2)
  newCost  Decimal? @db.Decimal(10, 2)

  reason String?
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model SystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String  @db.Text
  description String?
  category    String? // general, sales, inventory, etc.

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// -----------------------------------------------------------------------------
// ENTERPRISE POS MODELS
// -----------------------------------------------------------------------------

model CashRegister {
  id       String  @id @default(cuid())
  name     String // "Caja 1", "Caja Principal"
  code     String  @unique
  isActive Boolean @default(true)
  location String?

  sessions  CashSession[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CashSession {
  id         String       @id @default(cuid())
  registerId String
  register   CashRegister @relation(fields: [registerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  openingAmount  Decimal  @db.Decimal(10, 2)
  closingAmount  Decimal? @db.Decimal(10, 2)
  expectedAmount Decimal? @db.Decimal(10, 2)
  difference     Decimal? @db.Decimal(10, 2)

  status CashSessionStatus @default(OPEN)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  sales     Sale[]
  movements CashMovement[]

  notes        String? @db.Text
  closingNotes String? @db.Text

  @@index([registerId, status])
  @@index([userId])
}

model CashMovement {
  id        String      @id @default(cuid())
  sessionId String
  session   CashSession @relation(fields: [sessionId], references: [id])

  type      CashMovementType
  amount    Decimal          @db.Decimal(10, 2)
  reason    String
  reference String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Refund {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  amount Decimal    @db.Decimal(10, 2)
  reason String
  type   RefundType

  items RefundItem[]

  processedById String
  processedBy   User     @relation("ProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime @default(now())

  approvedBy String?

  @@index([saleId])
}

model RefundItem {
  id       String @id @default(cuid())
  refundId String
  refund   Refund @relation(fields: [refundId], references: [id])

  saleItemId String
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(10, 3)
  amount     Decimal @db.Decimal(10, 2)
}

model SaleDiscount {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  type   DiscountType
  value  Decimal      @db.Decimal(10, 2)
  amount Decimal      @db.Decimal(10, 2)

  promotionId String?
  reason      String?

  appliedBy    String
  authorizedBy String?

  createdAt DateTime @default(now())
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status OrderStatus @default(PENDING)
  type   OrderType

  items OrderItem[]

  scheduledFor DateTime?
  completedAt  DateTime?

  notes String? @db.Text

  // When converted to sale
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

model ParkedSale {
  id   String @id @default(cuid())
  name String // "Mesa 5", "Cliente Juan"

  items    Json // Cart snapshot
  subtotal Decimal @db.Decimal(10, 2)

  userId     String
  customerId String?

  notes String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}
